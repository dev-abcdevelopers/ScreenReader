<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/changesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.App.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_light"
        app:navigationContentDescription="@string/cd_back"
        app:title="@string/changes_title">

        <ImageButton
            android:id="@+id/btnShareChanges"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_gravity="end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/changes_share"
            android:src="@drawable/ic_share"
            app:tint="@color/text_secondary" />

    </com.google.android.material.appbar.MaterialToolbar>

    <TextView
        android:id="@+id/tvChangesSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_sm"
        android:textAppearance="@style/TextAppearance.App.Caption" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupChanges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_sm"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipChangeAll"
            style="@style/Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/changes_filter_all" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipChangeDue"
            style="@style/Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/changes_filter_due" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipChangeOther"
            style="@style/Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/changes_filter_other" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipChangeSkipped"
            style="@style/Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/changes_filter_skipped" />

    </com.google.android.material.chip.ChipGroup>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/changesScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_xl"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/changesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/emptyState"
            layout="@layout/partial_empty_state" />

    </FrameLayout>

</LinearLayout>
