<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/listPane"
        android:layout_width="@dimen/policy_list_pane_width"
        android:layout_height="match_parent"
        android:background="@color/surface_light" />

    <View
        android:id="@+id/paneDivider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/divider" />

    <FrameLayout
        android:id="@+id/detailPaneFrame"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@color/bg_light">

        <LinearLayout
            android:id="@+id/panePlaceholder"
            android:layout_width="@dimen/detail_placeholder_max_width"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivPanePlaceholder"
                android:layout_width="@dimen/icon_lg"
                android:layout_height="@dimen/icon_lg"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_list"
                app:tint="@color/text_faint" />

            <TextView
                android:id="@+id/tvPanePlaceholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center"
                android:text="@string/pane_pick_policy"
                android:textAppearance="@style/TextAppearance.App.Label"
                android:textColor="@color/text_muted" />

        </LinearLayout>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/detailPane"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

</LinearLayout>
