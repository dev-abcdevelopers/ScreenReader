<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dueReasonRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_sm"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/dueReasonHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_min"
        android:orientation="horizontal">

        <View
            android:id="@+id/dueReasonDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="@dimen/space_md"
            android:background="@drawable/bg_live_dot" />

        <TextView
            android:id="@+id/tvDueReasonTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDueReasonCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.App.Caption" />

        <ImageView
            android:id="@+id/ivDueReasonChevron"
            android:layout_width="@dimen/icon_sm"
            android:layout_height="@dimen/icon_sm"
            android:layout_marginStart="@dimen/space_sm"
            android:contentDescription="@null"
            android:rotation="90"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/text_faint" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/dueReasonBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDueReasonWhy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.3"
            android:textAppearance="@style/TextAppearance.App.Caption" />

        <LinearLayout
            android:id="@+id/dueReasonDates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</LinearLayout>
