<?xml version="1.0" encoding="utf-8"?>
<!--
  One capture source as an accordion card. The header only expands and
  collapses; Capture and Refresh live inside the body so the action always
  names the section it belongs to.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/groupCard"
    style="@style/Widget.App.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/card_gap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/groupHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_min"
            android:orientation="horizontal"
            android:paddingStart="@dimen/card_padding"
            android:paddingEnd="@dimen/card_padding">

            <TextView
                android:id="@+id/tvGroupTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.App.Overline" />

            <TextView
                android:id="@+id/tvGroupCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:textAppearance="@style/TextAppearance.App.Caption" />

            <ImageView
                android:id="@+id/ivGroupChevron"
                android:layout_width="@dimen/icon_sm"
                android:layout_height="@dimen/icon_sm"
                android:layout_marginStart="@dimen/space_sm"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/text_muted" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/groupBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/card_padding"
            android:paddingEnd="@dimen/card_padding"
            android:paddingBottom="@dimen/space_md"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/groupFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvGroupEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_xs"
                android:paddingBottom="@dimen/space_sm"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGroupAction"
                style="@style/Widget.App.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
