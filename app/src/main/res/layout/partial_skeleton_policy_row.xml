<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:importantForAccessibility="noHideDescendants"
    android:minHeight="@dimen/touch_min"
    android:orientation="horizontal"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/space_md"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_md">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <View
            android:layout_width="180dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_skeleton_bar" />

        <View
            android:layout_width="120dp"
            android:layout_height="10dp"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_skeleton_bar" />

    </LinearLayout>

    <View
        android:layout_width="56dp"
        android:layout_height="20dp"
        android:layout_marginStart="@dimen/space_md"
        android:background="@drawable/bg_skeleton_bar" />

</LinearLayout>
