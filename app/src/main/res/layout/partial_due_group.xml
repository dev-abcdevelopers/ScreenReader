<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dueGroupRoot"
    style="@style/Widget.App.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/card_gap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/dueGroupHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_min"
            android:orientation="horizontal"
            android:paddingStart="@dimen/card_padding"
            android:paddingEnd="@dimen/card_padding">

            <View
                android:id="@+id/dueGroupDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="@dimen/space_md"
                android:background="@drawable/bg_live_dot" />

            <TextView
                android:id="@+id/tvDueGroupTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDueGroupCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.App.Caption" />

            <ImageView
                android:id="@+id/ivDueGroupChevron"
                android:layout_width="@dimen/icon_sm"
                android:layout_height="@dimen/icon_sm"
                android:layout_marginStart="@dimen/space_sm"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_faint" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/dueGroupBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/card_padding"
            android:paddingEnd="@dimen/card_padding"
            android:paddingBottom="@dimen/card_padding"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvDueGroupWhy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_sm"
                android:lineSpacingMultiplier="1.3"
                android:textAppearance="@style/TextAppearance.App.Caption" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/dueGroupChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="@dimen/space_xs"
                app:chipSpacingVertical="@dimen/space_xs" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
