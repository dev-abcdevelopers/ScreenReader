<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mpinRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.App.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_light"
        app:navigationContentDescription="@string/cd_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/mpin_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_xl">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mpin_heading"
                android:textAppearance="@style/TextAppearance.App.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/mpin_body"
                android:textAppearance="@style/TextAppearance.App.Label"
                android:textColor="@color/text_muted" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mpin_field_heading"
                        android:textAppearance="@style/TextAppearance.App.Overline" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/mpin_field_hint"
                        android:textAppearance="@style/TextAppearance.App.Caption" />

                    <LinearLayout
                        android:id="@+id/mpinBoxRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/edtMpin1"
                            style="@style/Widget.App.MpinBox"
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:layout_weight="1" />

                        <EditText
                            android:id="@+id/edtMpin2"
                            style="@style/Widget.App.MpinBox"
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1" />

                        <EditText
                            android:id="@+id/edtMpin3"
                            style="@style/Widget.App.MpinBox"
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1" />

                        <EditText
                            android:id="@+id/edtMpin4"
                            style="@style/Widget.App.MpinBox"
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRevealMpin"
                        style="@style/Widget.App.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/mpin_show" />

                    <TextView
                        android:id="@+id/txtMpinError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        android:textColor="@color/status_red_text"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swAutoEnter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_min"
                        android:text="@string/mpin_auto_title"
                        android:textAppearance="@style/TextAppearance.App.Body" />

                    <TextView
                        android:id="@+id/txtAutoBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:lineSpacingMultiplier="1.3"
                        android:text="@string/mpin_auto_off_body"
                        android:textAppearance="@style/TextAppearance.App.Caption" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/txtMpinNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:background="@drawable/bg_warning_row"
                android:lineSpacingMultiplier="1.3"
                android:padding="@dimen/card_padding"
                android:text="@string/mpin_note"
                android:textAppearance="@style/TextAppearance.App.Label"
                android:textColor="@color/status_amber_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveMpin"
                style="@style/Widget.App.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:text="@string/mpin_save" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearMpin"
                style="@style/Widget.App.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/mpin_clear"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
