<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sessionRowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="76dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/space_md"
    android:paddingEnd="@dimen/space_sm"
    android:paddingBottom="@dimen/space_md">

    <ImageView
        android:layout_width="@dimen/icon_lg"
        android:layout_height="@dimen/icon_lg"
        android:layout_marginEnd="@dimen/space_md"
        android:contentDescription="@null"
        android:src="@drawable/ic_folder"
        app:tint="@color/primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSessionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.App.Heading" />

        <TextView
            android:id="@+id/tvSessionDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.App.Label" />

        <TextView
            android:id="@+id/tvSessionId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="middle"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.Caption" />

    </LinearLayout>

    <ImageView
        android:layout_width="@dimen/icon_md"
        android:layout_height="@dimen/icon_md"
        android:contentDescription="@string/sessions_open"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/text_faint" />

</LinearLayout>
