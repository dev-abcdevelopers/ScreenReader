<?xml version="1.0" encoding="utf-8"?>
<!--
  One card per policy, shaped like the due-date groups: the number sits in a
  tinted head so each record reads as its own object, and the body carries the
  holder, the due date and how much of the capture is about to go.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/deleteRowCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/card_gap"
    android:background="@drawable/bg_delete_row_card"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/deleteRowHead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_delete_row_head"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/card_padding"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/card_padding"
        android:paddingBottom="@dimen/space_sm">

        <ImageView
            android:id="@+id/ivDeleteRowIcon"
            android:layout_width="@dimen/icon_sm"
            android:layout_height="@dimen/icon_sm"
            android:layout_marginEnd="@dimen/space_sm"
            android:contentDescription="@null"
            android:src="@drawable/ic_policy"
            app:tint="@color/on_primary_container" />

        <TextView
            android:id="@+id/tvDeleteRowNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.App.Mono"
            android:textColor="@color/on_primary_container"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDeleteRowStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_badge_inforce"
            android:textAppearance="@style/TextAppearance.App.Caption"
            android:textColor="@color/status_green_text"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/deleteRowBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/card_padding"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/card_padding"
        android:paddingBottom="@dimen/space_sm">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDeleteRowName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Body" />

            <TextView
                android:id="@+id/tvDeleteRowDue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="@color/text_muted" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/deleteRowMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/pbDeleteRowFields"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="@dimen/completeness_bar_height"
                android:layout_marginEnd="@dimen/space_sm"
                android:layout_weight="1"
                android:indeterminate="false"
                android:max="100"
                android:maxHeight="@dimen/completeness_bar_height"
                android:minHeight="@dimen/completeness_bar_height"
                android:progressBackgroundTint="@color/card_stroke" />

            <TextView
                android:id="@+id/tvDeleteRowPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.App.Mono"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
