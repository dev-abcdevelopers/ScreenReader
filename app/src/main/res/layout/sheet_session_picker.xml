<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/space_lg"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_lg">

    <TextView
        android:id="@+id/tvSessionPickHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/capture_customer_pick_session"
        android:textAppearance="@style/TextAppearance.App.Heading" />

    <TextView
        android:id="@+id/tvSessionPickBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:layout_marginBottom="@dimen/space_md"
        android:text="@string/capture_customer_pick_body"
        android:textAppearance="@style/TextAppearance.App.Caption" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="360dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/sessionPickContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSessionPickCancel"
        style="@style/Widget.App.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/action_cancel" />

</LinearLayout>
