<?xml version="1.0" encoding="utf-8"?>
<!--
  Dense by design. An agent works through dozens of these in a sitting, so the
  row trades card padding for rows-per-screen and leans on a hairline divider
  instead of an outline.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/policySwipeRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/policyDeleteLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_sunken"
        android:gravity="center_vertical|start"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnPolicyDelete"
            android:layout_width="@dimen/policy_reveal_width"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/policies_delete"
            android:minHeight="@dimen/touch_min"
            android:scaleType="center"
            android:src="@drawable/ic_delete"
            app:tint="@color/status_red_text" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_light"
        android:baselineAligned="false"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_min"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/space_sm"
        android:paddingBottom="@dimen/space_md">

        <CheckBox
            android:id="@+id/cbPolicySelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_sm"
            android:clickable="false"
            android:contentDescription="@string/policies_select_one"
            android:focusable="false"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPolicyNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.App.Mono" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:background="@drawable/bg_badge_inforce"
                    android:textAppearance="@style/TextAppearance.App.Caption"
                    android:textColor="@color/status_green_text"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvHolderName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Body" />

            <TextView
                android:id="@+id/tvPlanName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPremium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.App.Metric" />

                <TextView
                    android:id="@+id/tvDueDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:textAppearance="@style/TextAppearance.App.Caption"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/icon_md"
            android:layout_height="@dimen/icon_md"
            android:contentDescription="@string/cd_open_policy"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/text_faint" />

    </LinearLayout>

</FrameLayout>
