<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/space_sm"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_lg">

    <View
        android:id="@+id/dueSheetHandle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/space_md"
        android:background="@drawable/bg_sheet_handle" />

    <LinearLayout
        android:id="@+id/dueHeroGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_hero_ok"
            android:contentDescription="@null"
            android:padding="@dimen/space_md"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/status_green_text" />

        <TextView
            android:id="@+id/tvDueHeroTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.App.Heading" />

        <TextView
            android:id="@+id/tvDueHeroBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:lineSpacingMultiplier="1.35"
            android:textAppearance="@style/TextAppearance.App.Caption" />

        <LinearLayout
            android:id="@+id/dueStatRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:baselineAligned="false"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/rowShowPolicies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_min"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvShowPolicies"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:textColor="@color/text_accent"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivShowPolicies"
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_accent" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/tvDuePreviewTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.App.Heading" />

    <TextView
        android:id="@+id/tvDuePreviewHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="@dimen/space_md"
        android:lineSpacingMultiplier="1.25"
        android:textAppearance="@style/TextAppearance.App.Caption" />

    <ScrollView
        android:id="@+id/duePreviewScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="240dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/duePreviewContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDuePreviewCancel"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_xs"
            android:layout_weight="1"
            android:text="@string/action_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDuePreviewApply"
            style="@style/Widget.App.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_weight="1" />

    </LinearLayout>

</LinearLayout>
