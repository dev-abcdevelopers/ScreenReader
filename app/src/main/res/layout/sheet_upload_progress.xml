<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_light"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_lg">

    <View
        android:layout_width="34dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginBottom="@dimen/space_lg"
        android:background="@drawable/bg_sheet_handle" />

    <FrameLayout
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/space_md">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressDeterminate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:indicatorSize="78dp"
            app:trackCornerRadius="4dp"
            app:trackThickness="7dp" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressIndeterminate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorSize="78dp"
            app:trackCornerRadius="4dp"
            app:trackThickness="7dp" />

        <TextView
            android:id="@+id/tvProgressPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textAppearance="@style/TextAppearance.App.Metric"
            android:textColor="@color/text_primary" />

        <ImageView
            android:id="@+id/ivProgressResult"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:layout_gravity="center"
            android:contentDescription="@string/upload_sheet_title"
            android:padding="18dp"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/tvUploadTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/upload_sheet_title"
        android:textAppearance="@style/TextAppearance.App.Heading" />

    <TextView
        android:id="@+id/tvUploadMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:layout_marginBottom="@dimen/space_lg"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:textColor="@color/text_muted" />

    <LinearLayout
        android:id="@+id/phaseList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivPhasePack"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/upload_phase_pack"
                android:src="@drawable/ic_record" />

            <TextView
                android:id="@+id/tvPhasePack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:text="@string/upload_phase_pack"
                android:textAppearance="@style/TextAppearance.App.Label" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivPhaseSend"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/upload_phase_send"
                android:src="@drawable/ic_record" />

            <TextView
                android:id="@+id/tvPhaseSend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:text="@string/upload_phase_send"
                android:textAppearance="@style/TextAppearance.App.Label" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivPhaseWait"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/upload_phase_wait"
                android:src="@drawable/ic_record" />

            <TextView
                android:id="@+id/tvPhaseWait"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:text="@string/upload_phase_wait"
                android:textAppearance="@style/TextAppearance.App.Label" />

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUploadPrimary"
        style="@style/Widget.App.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUploadSecondary"
        style="@style/Widget.App.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:text="@string/upload_action_cancel" />

</LinearLayout>
