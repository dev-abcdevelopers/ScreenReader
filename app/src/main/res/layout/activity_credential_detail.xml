<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/credentialRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/heroBand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_credential_hero"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_xl">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.App.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:navigationContentDescription="@string/cd_back"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/update_hero_text"
            app:titleTextColor="@color/update_hero_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin">

            <ImageView
                android:id="@+id/ivHeroIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_hero_icon"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/ic_lock"
                app:tint="@color/update_hero_text" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHeroTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/update_hero_text"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeroSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingMultiplier="1.25"
                    android:text="@string/credentials_hero_sub"
                    android:textColor="@color/update_hero_subtitle"
                    android:textSize="12.5sp" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tvHeroPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_hero_pill"
            android:paddingStart="@dimen/space_md"
            android:paddingTop="@dimen/space_xs"
            android:paddingEnd="@dimen/space_md"
            android:paddingBottom="@dimen/space_xs"
            android:textColor="@color/update_hero_text"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_xl">

            <TextView
                android:id="@+id/tvRejected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/card_gap"
                android:background="@drawable/bg_error_row"
                android:lineSpacingMultiplier="1.3"
                android:padding="@dimen/card_padding"
                android:textAppearance="@style/TextAppearance.App.Label"
                android:textColor="@color/status_red_text"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <TextView
                        android:id="@+id/tvFieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAllCaps="true"
                        android:textAppearance="@style/TextAppearance.App.Overline" />

                    <LinearLayout
                        android:id="@+id/boxRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/edtMpin1"
                            style="@style/Widget.App.MpinBox"
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:layout_weight="1" />

                        <EditText
                            android:id="@+id/edtMpin2"
                            style="@style/Widget.App.MpinBox"
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1" />

                        <EditText
                            android:id="@+id/edtMpin3"
                            style="@style/Widget.App.MpinBox"
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1" />

                        <EditText
                            android:id="@+id/edtMpin4"
                            style="@style/Widget.App.MpinBox"
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1" />

                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPassword"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:hint="@string/credentials_password_hint"
                        app:helperText="@string/credentials_password_rules"
                        app:endIconMode="password_toggle"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword"
                            android:maxLength="64"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="@dimen/space_xs"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnShow"
                            style="@style/Widget.App.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/credentials_show" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEdit"
                            style="@style/Widget.App.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/credentials_edit" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvFieldError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        android:textColor="@color/status_red_text"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:background="@drawable/bg_tile_green"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/credentials_do"
                    android:textAllCaps="true"
                    android:textAppearance="@style/TextAppearance.App.Overline"
                    android:textColor="@color/status_green_text" />

                <TextView
                    android:id="@+id/tvDo1"
                    style="@style/Widget.App.RuleLine"
                    android:textColor="@color/status_green_text" />

                <TextView
                    android:id="@+id/tvDo2"
                    style="@style/Widget.App.RuleLine"
                    android:textColor="@color/status_green_text" />

                <TextView
                    android:id="@+id/tvDo3"
                    style="@style/Widget.App.RuleLine"
                    android:textColor="@color/status_green_text" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:background="@drawable/bg_error_row"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/credentials_dont"
                    android:textAllCaps="true"
                    android:textAppearance="@style/TextAppearance.App.Overline"
                    android:textColor="@color/status_red_text" />

                <TextView
                    android:id="@+id/tvDont1"
                    style="@style/Widget.App.RuleLine"
                    android:textColor="@color/status_red_text" />

                <TextView
                    android:id="@+id/tvDont2"
                    style="@style/Widget.App.RuleLine"
                    android:textColor="@color/status_red_text" />

                <TextView
                    android:id="@+id/tvDont3"
                    style="@style/Widget.App.RuleLine"
                    android:textColor="@color/status_red_text" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:background="@drawable/bg_warning_row"
                android:lineSpacingMultiplier="1.3"
                android:padding="@dimen/card_padding"
                android:text="@string/credentials_note"
                android:textAppearance="@style/TextAppearance.App.Label"
                android:textColor="@color/status_amber_text" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLastSaved"
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/credentials_last_saved"
                        android:textAllCaps="true"
                        android:textAppearance="@style/TextAppearance.App.Overline" />

                    <TextView
                        android:id="@+id/tvLastSaved"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="@style/TextAppearance.App.Heading" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/credentials_last_saved_hint"
                        android:textAppearance="@style/TextAppearance.App.Caption" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/cardDanger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:background="@drawable/bg_danger_card"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_danger_icon"
                        android:contentDescription="@null"
                        android:padding="@dimen/space_sm"
                        android:src="@drawable/ic_delete"
                        app:tint="@color/status_red_text" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDangerTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.App.Heading"
                            android:textColor="@color/status_red_text" />

                        <TextView
                            android:id="@+id/tvDangerDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:lineSpacingMultiplier="1.3"
                            android:textAppearance="@style/TextAppearance.App.Caption" />

                    </LinearLayout>

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRemove"
                    style="@style/Widget.App.Button.Danger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/credentials_remove"
                    app:icon="@drawable/ic_delete"
                    app:iconGravity="textStart" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/actionDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_light"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/space_md">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/credentials_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.App.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:text="@string/credentials_save" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
