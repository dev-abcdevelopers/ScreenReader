    <string name="settings_pace_title">Pace</string>
    <string name="settings_pace_desc">How long to wait for each screen to settle</string>
    <string name="settings_pace_body">The LIC app needs a moment to draw each screen before it can be read. Slower is safer on older phones and weak networks.</string>
