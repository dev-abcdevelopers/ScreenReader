<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.DataReaderApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <item name="android:colorBackground">@color/bg_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_elevated</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/card_stroke</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>

        <item name="android:windowBackground">@color/bg_light</item>
        <!-- Edge to edge draws behind the bars; these keep the icons legible. -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <item name="bottomSheetDialogTheme">@style/Theme.DataReaderApp.BottomSheet</item>
    </style>

    <style name="Theme.DataReaderApp.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.App.BottomSheet</item>
    </style>

    <style name="Widget.App.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface_light</item>
    </style>

    <!--
      The update sheet paints a coloured band right up to its own top corners, so
      the sheet shape has to match the band's radius exactly or the sheet
      background shows through as two pale triangles.
    -->
    <style name="Theme.DataReaderApp.BottomSheet.Update" parent="Theme.DataReaderApp.BottomSheet">
        <item name="bottomSheetStyle">@style/Widget.App.BottomSheet.Update</item>
    </style>

    <style name="Widget.App.BottomSheet.Update" parent="Widget.App.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.App.BottomSheet.Update</item>
        <item name="shapeAppearanceOverlay">@null</item>
    </style>

    <style name="ShapeAppearance.App.BottomSheet.Update" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_lg</item>
        <item name="cornerSizeTopRight">@dimen/radius_lg</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!--
      The capture review sheet fills the screen, so it draws behind the status bar
      and squares its corners. paddingTopSystemWindowInsets is off because the
      sheet pads its own hero band with the status bar inset.
    -->
    <style name="Theme.DataReaderApp.BottomSheet.Review" parent="Theme.DataReaderApp.BottomSheet">
        <item name="bottomSheetStyle">@style/Widget.App.BottomSheet.Review</item>
        <item name="enableEdgeToEdge">true</item>
    </style>

    <style name="Widget.App.BottomSheet.Review" parent="Widget.App.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.App.BottomSheet.Review</item>
        <item name="shapeAppearanceOverlay">@null</item>
        <item name="backgroundTint">@color/review_hero_start</item>
        <item name="paddingTopSystemWindowInsets">false</item>
        <item name="paddingBottomSystemWindowInsets">false</item>
    </style>

    <style name="ShapeAppearance.App.BottomSheet.Review" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>

    <!-- ==================================================== type scale ==== -->

    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Heading" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Label" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.App.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="TextAppearance.App.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <!-- Tabular figures so policy numbers and amounts line up down a column. -->
    <style name="TextAppearance.App.Mono" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Metric" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- ==================================================== components ==== -->

    <!--
      Outlined rather than elevated. Shadows on a dense list of records add
      visual noise without adding information.
    -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_md</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface_light</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Kept so screens not yet migrated keep rendering. -->
    <style name="CardView.Modern" parent="Widget.App.Card" />

    <style name="Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">@dimen/radius_sm</item>
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">@color/card_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipMinHeight">36dp</item>
    </style>

    <style name="Widget.App.RuleLine" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_sm</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Label</item>
    </style>

    <style name="Widget.App.MpinBox" parent="">
        <item name="android:background">@drawable/bg_mpin_box</item>
        <item name="android:gravity">center</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:inputType">numberPassword</item>
        <item name="android:maxLength">1</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="cornerRadius">@dimen/radius_sm</item>
    </style>

    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="cornerRadius">@dimen/radius_sm</item>
    </style>

    <style name="Widget.App.Button.Danger" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="cornerRadius">@dimen/radius_sm</item>
        <item name="android:textColor">@color/status_red_text</item>
        <item name="strokeColor">@color/status_red_text</item>
        <item name="iconTint">@color/status_red_text</item>
        <item name="rippleColor">@color/status_red_bg</item>
    </style>

    <style name="Widget.App.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_min</item>
    </style>

    <style name="Widget.App.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextColor">@color/text_muted</item>
        <item name="navigationIconTint">@color/text_secondary</item>
    </style>

    <style name="Widget.App.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/Widget.App.BottomNav.Indicator</item>
        <item name="itemIconTint">@color/bottom_nav_item</item>
        <item name="itemTextColor">@color/bottom_nav_item</item>
        <item name="backgroundTint">@color/surface_light</item>
    </style>

    <style name="Widget.App.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary_container</item>
    </style>

</resources>
